# Шаг 1: Сборка React приложения
FROM node:20-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

# Передаем переменную окружения во время сборки
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# Шаг 2: Раздача статики через Nginx
FROM nginx:alpine

# Копируем скомпилированную статику из первого шага в директорию Nginx
COPY --from=build /app/dist /usr/share/nginx/html

# Копируем кастомный nginx.conf
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
